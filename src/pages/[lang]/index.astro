---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';
import { menuData } from '../../data/menuData';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}
const { lang } = Astro.params;
const t = useTranslations(lang);

// Get first 3 featured items
const featuredMenu = menuData[lang][1].items.slice(0, 3);
---

<Layout title="Saboria" lang={lang} t={t}>
  <section id="inicio" class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?q=80&w=1934&auto=format&fit=crop" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-stone-900/60 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-900/40 to-transparent"></div>
    </div>
    <div class="relative z-10 text-center px-4 max-w-5xl mx-auto mt-20">
      <span class="inline-block py-1 px-3 rounded-full bg-orange-500/20 text-orange-300 backdrop-blur-md border border-orange-500/30 text-sm font-semibold tracking-wider uppercase mb-6 shadow-2xl">
        {t('hero.badge')}
      </span>
      <h1 class="text-5xl sm:text-6xl md:text-8xl font-bold font-serif text-white mb-6 drop-shadow-lg leading-tight">
        {t('hero.title1')} <br/><span class="text-orange-400 italic">{t('hero.title2')}</span> {t('hero.title3')}
      </h1>
      <p class="text-lg sm:text-xl text-stone-200 mb-10 max-w-2xl mx-auto font-light drop-shadow">
        {t('hero.subtitle')}
      </p>
      <div class="flex gap-4 justify-center">
        <a href={`/${lang}/menu`} class="px-8 py-4 rounded-full bg-orange-600 text-white font-bold hover:bg-orange-700 transition-all">{t('hero.btn.menu')}</a>
        <a href="#reservaciones" class="px-8 py-4 rounded-full bg-white/10 text-white font-bold backdrop-blur-md border border-white/20 hover:bg-white/20 transition-all">{t('hero.btn.res')}</a>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="lg:w-1/2 relative">
          <div class="absolute -inset-4 bg-orange-100 rounded-3xl transform -rotate-3 z-0"></div>
          <img src="https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?q=80&w=2070&auto=format&fit=crop" class="relative z-10 rounded-3xl shadow-2xl w-full h-auto object-cover" />
          <div class="absolute -bottom-10 -right-10 bg-white p-6 rounded-3xl shadow-xl z-20 hidden md:block">
            <p class="font-serif text-5xl font-bold text-orange-600 mb-1">{t('presentation.exp1')}</p>
            <p class="text-stone-600 font-semibold uppercase tracking-wider text-sm">{t('presentation.exp2')}</p>
          </div>
        </div>
        <div class="lg:w-1/2">
          <span class="text-orange-600 font-semibold tracking-wider uppercase text-sm">{t('presentation.badge')}</span>
          <h2 class="text-4xl md:text-5xl font-bold font-serif text-stone-900 mt-4 mb-6" set:html={t('presentation.title')}></h2>
          <p class="text-stone-600 mb-6 leading-relaxed text-lg" set:html={t('presentation.p1')}></p>
          <p class="text-stone-600 mb-8 leading-relaxed text-lg" set:html={t('presentation.p2')}></p>
          <a href={`/${lang}/sugerencias`} class="inline-flex items-center gap-2 font-bold text-orange-600 hover:text-orange-800 transition-colors">
            {t('presentation.link')} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="menu" class="py-24 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-orange-600 font-semibold tracking-wider uppercase text-sm">{t('feat.badge')}</span>
        <h2 class="text-4xl md:text-5xl font-bold font-serif text-stone-900 mt-2">{t('feat.title')}</h2>
        <div class="w-24 h-1 bg-orange-500 mx-auto mt-6 rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {featuredMenu.map((item) => (
          <div class="group bg-white rounded-3xl overflow-hidden shadow-xl hover:-translate-y-2 transition-all">
            <div class="relative h-64 overflow-hidden">
              <img src={item.image} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full font-bold text-stone-900 shadow-lg">{item.price}</div>
            </div>
            <div class="p-8">
              <h3 class="text-2xl font-bold font-serif text-stone-900 mb-3">{item.name}</h3>
              <p class="text-stone-600 text-sm leading-relaxed mb-6">{item.description}</p>
              <button onclick={`window.addToCart('${item.name}', '${item.price}', '${item.image}')`} class="text-orange-600 font-bold text-sm uppercase tracking-wider flex items-center gap-2 group/btn">
                {t('menu.add')}
              </button>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-16 text-center">
        <a href={`/${lang}/menu`} class="inline-block px-8 py-4 rounded-full border-2 border-stone-900 text-stone-900 font-bold hover:bg-stone-900 hover:text-white transition-all">
          {t('feat.btn')}
        </a>
      </div>
    </div>
  </section>

  <section id="ubicacion" class="py-24 bg-stone-100">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <span class="text-orange-600 font-semibold tracking-wider uppercase text-sm">{t('loc.badge')}</span>
        <h2 class="text-4xl md:text-5xl font-bold font-serif text-stone-900 mt-2">{t('loc.title')}</h2>
        <div class="w-24 h-1 bg-orange-500 mx-auto mt-6 rounded-full"></div>
        <p class="mt-6 text-stone-600 max-w-2xl mx-auto">{t('loc.desc')}</p>
      </div>
      <div class="rounded-3xl overflow-hidden shadow-2xl h-[500px] border-4 border-white">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119275.63102142273!2d-89.69992524458316!3d20.9984950346387!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f56715f5cc173ef%3A0xc6c7d3f82025ed!2sPaseo%20de%20Montejo%2C%20Zona%20Paseo%20Montejo%2C%20M%C3%A9rida%2C%20Yuc.!5e0!3m2!1ses-419!2smx!4v1710000000000!5m2!1ses-419!2smx" width="100%" height="100%" style="border:0;" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <section id="reservaciones" class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 relative z-10">
      <div class="bg-stone-900 rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
        <div class="md:w-2/5 bg-stone-800 p-10 text-white flex flex-col justify-between">
          <div>
            <h3 class="text-3xl font-bold font-serif mb-4">{t('res.title')}</h3>
            <p class="text-stone-300 text-sm mb-8">{t('res.desc')}</p>
          </div>
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div><p class="text-xs text-stone-400">{t('res.call')}</p><p class="font-semibold">+1 234 567 890</p></div>
            </div>
            <div class="flex items-center gap-4">
              <div><p class="text-xs text-stone-400">{t('res.write')}</p><p class="font-semibold">hola@saboria.com</p></div>
            </div>
          </div>
        </div>
        <div class="md:w-3/5 p-10 bg-white">
          <form class="space-y-6">
            <div>
              <label class="block text-sm font-semibold text-stone-700 mb-2">{t('res.form.name')}</label>
              <input type="text" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200" placeholder={t('res.form.name.ph')} required>
            </div>
            <div>
              <label class="block text-sm font-semibold text-stone-700 mb-2">{t('res.form.email')}</label>
              <input type="email" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200" placeholder={t('res.form.email.ph')} required>
            </div>
            <div>
              <label class="block text-sm font-semibold text-stone-700 mb-2">{t('res.form.msg')}</label>
              <textarea rows="4" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 resize-none" placeholder={t('res.form.msg.ph')} required></textarea>
            </div>
            <button type="submit" class="w-full py-4 rounded-xl bg-orange-600 text-white font-bold">{t('res.form.btn')}</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
